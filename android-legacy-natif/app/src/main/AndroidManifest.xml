<?xml version="1.0" encoding="utf-8"?>
<!--
    Cree le 23/08/2026, Bourama : Lot 1 Partie 3 (app mobile), socle Android.
    Etendu 23/08/2026, Lot 3 (notifications & rappels), Lot 4 (controles de
    session) et Lot 5 (connecteurs tiers) : voir sections marquees ci-dessous.
    Permissions COMMUNES aux deux flavors (play et externe). Toute permission
    specifique a l'accessibilite (lots 6-8) va dans src/externe/AndroidManifest.xml,
    jamais ici, voir 00-commun.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permission speciale : ne s'accorde pas via une popup standard, l'app
         doit rediriger l'etudiant vers Reglages > Acces aux donnees d'usage
         (voir UsageScreen.kt, ACTION_USAGE_ACCESS_SETTINGS). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lot 4, "Acces a la Politique de Notification" : meme famille de
         permission speciale que PACKAGE_USAGE_STATS ci-dessus : ne s'accorde
         pas via une popup standard, redirection vers Reglages via
         ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS (voir
         ControleSessionRepository.kt). Necessaire pour basculer le Ne pas
         deranger ET pour ajuster le volume sonnerie/notifications pendant
         une session (Android bloque sinon ce dernier avec SecurityException). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Lot 3 : notification standard, obligatoire a partir d'Android 13
         (API 33), demandee au runtime (voir RappelsScreen.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lot 3 : alerte plein ecran (categorie ALARM). Declaree ici par
         precaution, MAIS voir CanalNotifications.kt : depuis la politique
         Google Play 2025, accordee automatiquement seulement aux apps
         classees appels/alarme : Clovis n'en fait pas partie, repli
         heads-up prevu cote code si refusee. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Lot 3 : visibilite de packages (Android 11+, voir RappelsNatifs.kt
         pour le detail de cette restriction et son impact sur l'ouverture
         d'app tierce). Seules les apps natives Horloge/Calendrier sont
         couvertes ici via leurs ACTIONS (pas de package explicite requis). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>

        <!-- Ajoute le 30/08/2026, Bourama : sans ce bloc, Android 11+ refuse
             de donner le nom lisible (ex "Instagram") des autres applis a
             UsageStatsRepository (temps d'ecran) et EcranAccessibilite
             (journal debug), qui retombaient alors sur le nom technique brut
             (ex "com.instagram.android"). Ce bloc autorise generiquement
             Clovis a voir toute appli qui peut etre ouverte depuis l'ecran
             d'accueil (meme mecanisme deja utilise dans
             EcranAccessibilite.listerAppsLancables, voir commentaire
             a cet endroit) -- forme acceptee par le Play Store, contrairement
             a la permission QUERY_ALL_PACKAGES qui elle est tres restreinte. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ClovisApplication"
        android:label="Clovis"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lot 5 : recoit la redirection OAuth (Notion, puis autres
             connecteurs) sur le schema clovismobile://oauth-callback, ouvert
             via Custom Tabs depuis ConnecteursScreen.kt. launchMode=
             singleTask pour ne pas empiler une nouvelle instance par-dessus
             MainActivity a chaque retour OAuth. -->
        <activity
            android:name=".ui.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clovismobile" android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <!-- Lot 3 : cible de l'alerte plein ecran (voir NotificationsNatives.kt).
             exported=false : jamais lancee par une autre app, uniquement en
             interne via PendingIntent. -->
        <activity
            android:name=".notifications.AlerteRappelActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:excludeFromRecents="true" />

        <!-- Lot 3 : reception des notifications push (voir
             clovis-backend/core/notifications_push.py). exported=false :
             seul le systeme (via le SDK Firebase) peut demarrer ce service. -->
        <service
            android:name=".notifications.ClovisFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Lot 3 : tuile reglages rapides (option A du raccourci "Clovis
             partout", voir ClovisTileService.kt). Permission BIND_QUICK_SETTINGS_TILE
             obligatoire : seul le systeme peut se lier a ce service. -->
        <service
            android:name=".notifications.ClovisTileService"
            android:exported="true"
            android:icon="@drawable/ic_clovis_notification"
            android:label="Clovis"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lot 3 : widget ecran d'accueil (option A du raccourci, voir
             ClovisWidgetProvider.kt). -->
        <receiver
            android:name=".notifications.ClovisWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clovis_widget_info" />
        </receiver>

    </application>
</manifest>
