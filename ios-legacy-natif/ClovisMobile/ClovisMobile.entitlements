<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Cree le 23/08/2026, Bourama : entitlement Family Controls, necessaire
        pour demander l'autorisation .individual (temps par app). Se demande
        via Apple (formulaire "Family Controls Distribution" du compte
        Apple Developer Program), pas disponible par defaut meme avec un
        compte payant actif -- voir ios/README.md.
    -->
    <key>com.apple.developer.family-controls</key>
    <true/>

    <!--
        Lot 3, 23/08/2026 : entitlement Push Notifications, necessaire pour
        qu'APNs accepte d'enregistrer l'app (didRegisterForRemoteNotificationsWithDeviceToken).
        Se coche normalement depuis Xcode (Signing & Capabilities > + Push
        Notifications), qui gere aussi la creation du profil de
        provisionnement associe -- necessite le compte Apple Developer
        Program (meme dependance que family-controls ci-dessus, voir
        ios/README.md). "development" ici ; Xcode bascule automatiquement
        sur "production" a l'archivage pour l'App Store.
    -->
    <key>aps-environment</key>
    <string>development</string>
</dict>
</plist>
